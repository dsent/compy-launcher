<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#555555" /><stroke android:width="2dp" android:color="#FFFFFF" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#333333" /><stroke android:width="2dp" android:color="#FFE066" /></shape>
    </item>
    <item>
        <shape><solid android:color="#303030" /><stroke android:width="1dp" android:color="#666666" /></shape>
    </item>
</selector>
